{
  "name": "wearetrades-academy",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "node scripts/project.mjs install",
    "dev": "node scripts/project.mjs dev",
    "build": "node scripts/project.mjs build",
    "start": "node scripts/project.mjs start",
    "test": "npm run build && node --test tests/*.test.mjs",
    "validate:artifact": "node scripts/project.mjs validate",
    "lint": "node scripts/project.mjs lint",
    "db:generate": "node scripts/project.mjs db:generate",
    "db:local": "node scripts/project.mjs db:local",
    "backup:local": "node scripts/project.mjs backup-local",
    "typecheck": "tsc --noEmit --incremental false",
    "test:unit": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
